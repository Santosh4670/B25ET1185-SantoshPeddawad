#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    // Parameterized constructor
    Complex(float r, float i)
    {
        real = r;
        imag = i;
    }

    // Overloading / operator
    Complex operator/(float scalar)
    {
        return Complex(real / scalar, imag / scalar);
    }

    // Display complex number
    void display()
    {
        cout << real << " + " << imag << "i";
    }
};

int main()
{
    Complex c1(10, 6);

    float scalar = 2;

    Complex result = c1 / scalar;

    cout << "Complex number: ";
    c1.display();

    cout << "\nScalar value: " << scalar;

    cout << "\nResult after division: ";
    result.display();

    return 0;
}
